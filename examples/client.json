{
  "log": { "level": "warn", "timestamp": true },
  "inbounds": [{ "type": "mixed", "tag": "local", "listen": "127.0.0.1", "listen_port": 1080 }],
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": ["reality", "anytls", "hysteria2"],
      "default": "reality"
    },
    {
      "type": "anytls",
      "tag": "anytls",
      "server": "__SERVER_IP__",
      "server_port": 8443,
      "password": "__ANYTLS_PASSWORD__",
      "tls": { "enabled": true, "server_name": "__TLS_SERVER_NAME__", "insecure": false }
    },
    {
      "type": "hysteria2",
      "tag": "hysteria2",
      "server": "__SERVER_IP__",
      "server_port": 443,
      "password": "__HYSTERIA_PASSWORD__",
      "tls": { "enabled": true, "server_name": "__TLS_SERVER_NAME__", "insecure": false }
    },
    {
      "type": "vless",
      "tag": "reality",
      "server": "__SERVER_IP__",
      "server_port": 443,
      "uuid": "__VLESS_UUID__",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "__REALITY_SERVER_NAME__",
        "insecure": false,
        "utls": { "enabled": true, "fingerprint": "chrome" },
        "reality": {
          "enabled": true,
          "public_key": "__REALITY_PUBLIC_KEY__",
          "short_id": "__REALITY_SHORT_ID__"
        }
      }
    }
  ],
  "route": { "final": "proxy" }
}
